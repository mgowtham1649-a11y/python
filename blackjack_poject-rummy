import random

def deal_card():
    card=[11,2,3,4,5,6,7,8,9,10,10,10]
    return random.choice(card)
def calculate_score(card):
    if sum(card)==21 and len(card)==2:
        return 0
    if 11 in card and sum(card)>21:
        card.remove(11)
        card.append(1)
    return sum(card)
